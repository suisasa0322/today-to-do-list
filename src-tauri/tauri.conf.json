{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Today To Do List",
  "version": "0.1.0",
  "identifier": "com.suisasa.todaytodolist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Today To Do List",
        "width": 360,
        "height": 460,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
